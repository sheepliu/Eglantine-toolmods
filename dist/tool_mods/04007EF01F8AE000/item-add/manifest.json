{
  "manifest_version": 1,
  "api_version": 1,
  "id": "item-add",
  "name": "Item Add Runtime",
  "version": "0.3.1",
  "catalog": "items.json",
  "runtime": "../../../python-runtime/python.exe",
  "entrypoint": "itemadd_gdb.py",
  "entrypoint_args": [
    "-X",
    "utf8",
    "{entrypoint}",
    "--mode",
    "commit",
    "--iid",
    "{iid}",
    "--quantity",
    "{quantity}",
    "--wait",
    "180",
    "--skip-local-main-check",
    "--cancel-file",
    "{cancel_file}",
    "--report-dir",
    "{package_dir}\\reports"
  ],
  "capabilities": ["inventory.add", "guest.gdb"]
}
